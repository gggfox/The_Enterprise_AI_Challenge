# Copy to .env (which is gitignored) and fill in real values for local
# `docker compose up`. Dokploy injects its own env at deploy time.
#
# Server-side runtime config goes here (read by Node at boot, not baked
# into the bundle). VITE_* values are baked at `vite build` time and
# would need to move into Dockerfile ARGs to flow through.

# ---------- Convex ----------
# `npx convex dev` writes the deployment URL into .env.local for the
# Convex CLI; copy the same value here so apps/api and apps/web
# pick it up.
CONVEX_URL=https://example-deployment.convex.cloud
# Optional. Only needed for deploy-key-authenticated server calls --
# the bridge does not require it for the hackathon flow.
CONVEX_DEPLOY_KEY=

# ---------- Clerk (identity provider) ----------
# Frontend API URL for your Clerk instance (used as the JWT issuer).
# Found in Clerk Dashboard -> API keys. Looks like:
#   https://<your-app>.clerk.accounts.dev   (dev)
#   https://clerk.<your-domain>.com         (prod)
# Convex (auth.config.ts) and the Bridge (apps/api) both read this.
CLERK_ISSUER_URL=https://example-app.clerk.accounts.dev
# Optional override. Defaults to `<CLERK_ISSUER_URL>/.well-known/jwks.json`.
CLERK_JWKS_URL=

# ---------- Bridge API ----------
HTTP_PORT=3111
DASHBOARD_ORIGIN=http://localhost:3000
# Long-lived secrets. Generate with: openssl rand -hex 32
BRIDGE_API_KEY=replace-me-bridge
ADMIN_API_KEY=replace-me-admin

# ---------- Observability (OpenObserve) ----------
OTEL_ENABLED=true
# Default OpenObserve OTLP endpoint when running via infra/docker-compose.yml.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5081
# Comma-separated headers, e.g. "Authorization=Basic <base64-user:pass>".
# OpenObserve requires this for non-default orgs/streams.
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=enterprise-ai-api
SERVICE_VERSION=0.1.0
SERVICE_NAMESPACE=development
DEPLOYMENT_REGION=local
WIDE_EVENT_SLOW_MS=2000
WIDE_EVENT_SUCCESS_SAMPLE_RATE=1.0

# ---------- OpenObserve container ----------
ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=replace-me-openobserve

# ---------- Frontend ----------
# Same Convex URL as above; vite needs the VITE_ prefix to expose it
# to the browser bundle.
VITE_CONVEX_URL=https://example-deployment.convex.cloud
VITE_API_BASE=http://localhost:3111
# Clerk publishable key. Found in Clerk Dashboard -> API keys.
# Looks like `pk_test_...` (dev) or `pk_live_...` (prod). Safe to ship
# in the bundle; Clerk treats this as a public identifier.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace-me

# ---------- Deepgram ----------
# Server-side key (used by future Bridge endpoints, e.g. minting
# short-lived browser keys for the Voice Agent).
DEEPGRAM_API_KEY=replace-me
# DEMO ONLY: Voice Agent runs in the browser today and reads this key
# directly from the bundle. Replace with a server-minted ephemeral key
# before any real deploy.
VITE_DEEPGRAM_API_KEY=replace-me
