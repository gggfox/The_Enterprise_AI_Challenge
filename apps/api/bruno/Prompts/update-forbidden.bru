meta {
  name: Update prompt (forbidden)
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/prompts/{{promptId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerJwt}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "title": "Should be forbidden"
  }
}

docs {
  Same as Update but expected to fail. Set `bearerJwt` to a token for a
  user who is NOT the prompt's author and is NOT admin/moderator. The
  Bridge returns 403 with `{ error: { reason: "forbidden", action:
  "update", resource: "prompt" } }`.
}
