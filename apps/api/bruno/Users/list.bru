meta {
  name: List users
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerJwt}}
}

headers {
  Accept: application/json
}

docs {
  Lists all users. Requires the caller's role to grant `view:user`
  (admin or moderator).
}
