meta {
  name: Example webhook
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/webhooks/example
  body: json
  auth: apikey
}

auth:apikey {
  key: x-api-key
  value: {{bridgeApiKey}}
  placement: header
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "event": "demo",
    "payload": { "ok": true }
  }
}

docs {
  Stub webhook endpoint guarded by BRIDGE_API_KEY. Demonstrates the
  /api/v1/webhooks/** auth-by-prefix policy.
}
